generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Saison {
  PRINTEMPS
  ETE
  AUTOMNE
  HIVER
  TOUTES_SAISONS
}
enum Type {
  VETEMENT
  CHAUSSURE
  ALIMENT
  MONTRE
}

enum Role {
  ADMIN
  CAISSE
  GESTIONNAIRE
  COMPTABLE
  LOGISTIQUE
}

enum Genres {
  HOMME
  FEMME
}

enum Statut {
  DISPONIBILITE
  VENDU
  PROMO 
}
enum StatutCommande {
  EN_ATTENTE
  EN_COURS
  LIVREE
  ANNULEE
}

// Action effectuée par un utilisateur
model Audit {
  id       String @id() @default(uuid()) @db.Uuid
  table    String
  table_id String
  message  String
  ip       String

  // Relation avec Utilisateur
  utilisateur    Utilisateur @relation(fields: [utilisateur_id], references: [id])
  utilisateur_id String      @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("audits")
}

// Pour les vêtements, on a T-shirt, Pantalon, etc.
model Categorie {
  id          String  @id() @default(uuid()) @db.Uuid
  reference   String  @unique
  nom         String
  description String? @db.Text

  // Relation avec Type
  type Type @default(VETEMENT)

  // Relation avec Article
  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("categories")
}

model Collection {
  id          String  @id() @default(uuid()) @db.Uuid
  reference   String  @unique
  nom         String
  description String? @db.Text
  saison      Saison

  // Relation avec Article
  articles Article[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("collections")
}

model Otp {
  id      String   @id() @default(uuid()) @db.Uuid
  code    String
  expire  DateTime
  email   String
  counter Int
}

model CounterOtp {
  id      String @id @default(uuid()) @db.Uuid
  counter Int    @default(0)
}

model Article {
  id             String    @id @default(uuid()) @db.Uuid
  reference      String    @unique
  nom            String
  description    String?   @db.Text
  infos          Json      @db.Json
  status         Statut    @default(DISPONIBILITE)
  image          String?
  quantite       Int?
  prix           Float  
  genre          Genres     @default(HOMME)
  estEnPromotion Boolean?  @default(false)
  prixPromotion  Float?    @default(0)

  // Relation avec Categorie (optionnelle, onDelete: SetNull)
  categorie      Categorie? @relation(fields: [categorie_id], references: [id], onDelete: SetNull)
  categorie_id   String?    @db.Uuid

  lignesCommande LigneCommande[]

  // Relation avec Collection (optionnelle, onDelete: SetNull)
  collection    Collection? @relation(fields: [collection_id], references: [id], onDelete: SetNull)
  collection_id String?     @db.Uuid

  varietes Variete[]
  notes Note[]
  favoris Favoris[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("articles")
}

model Variete {
  id        String   @id() @default(uuid()) @db.Uuid
  reference String
  couleur   String
  tailles   Json?    @db.Json
  image     String?
  lignesCommande LigneCommande[]

  // Relation avec Article
  article    Article @relation(fields: [article_id], references: [id], onDelete: Cascade)
  article_id String  @db.Uuid

  @@map("varietes")
}

model LigneCommande {
  id            String    @id @default(uuid()) @db.Uuid
  quantite      Int
  prixUnitaire  Float
  taille        String?
  couleur       String?

  article_id    String?   @db.Uuid
  article       Article?  @relation(fields: [article_id], references: [id])

  variete_id    String?   @db.Uuid
  variete       Variete?  @relation(fields: [variete_id], references: [id])

  commande_id   String    @db.Uuid
  commande      Commande  @relation(fields: [commande_id], references: [id])

  @@map("lignes_commande")
}

model Commande {
  id           String         @id @default(uuid()) @db.Uuid
  date         DateTime       @default(now())
  reference    String         @unique
  statut       StatutCommande @default(EN_ATTENTE)
  total        Float
  remise       Float?         @default(0)
  totalPaye    Float?         @default(0)

  utilisateur    Utilisateur?  @relation(fields: [utilisateurId], references: [id])
  utilisateurId  String?       @db.Uuid @map("utilisateur_id")

  client      Client       @relation(fields: [clientId], references: [id])
  clientId    String       @db.Uuid @map("client_id")

  lignes      LigneCommande[]
}

model Note {
  id          String  @id() @default(uuid())
  etoile      Decimal
  commentaire String
  reponse     String? @db.Uuid

  client    Client @relation(fields: [client_id], references: [id])
  client_id String @db.Uuid

  article    Article @relation(fields: [article_id], references: [id])
  article_id String  @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("notes")
}

model Favoris {
  id String @id() @default(uuid())

  client    Client @relation(fields: [client_id], references: [id])
  client_id String @db.Uuid

  article    Article @relation(fields: [article_id], references: [id])
  article_id String  @db.Uuid

  @@unique([client_id, article_id])
  @@map("favoris")
}

model Utilisateur {
  id             String    @id() @default(uuid()) @db.Uuid
  nomComplet     String
  nomUtilisateur String    @unique
  email          String    @unique
  password       String
  role           Role      @default(ADMIN)
  date_naissance DateTime? @db.Date
  genre          Genres?
  avatar         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  commandes Commande[]
  audits Audit[]

  @@map("utilisateurs")
}

model Client {
  id             String    @id() @default(uuid()) @db.Uuid
  nom            String
  prenom         String
  nomUtilisateur String    @unique
  email          String    @unique
  phone          String
  password       String
  genre          Genres @default(HOMME)
  adresse        String
  date_naissance DateTime? @db.Date
  avatar         String?
  isActive       Boolean? @default(true)
  totalOrders    BigInt?
  totalSpent     BigInt?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  commandes      Commande[]
  favoris        Favoris[]
  notes          Note[]

  @@map("clients")
}
